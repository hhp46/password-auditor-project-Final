# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore virtual environments (in case one is created)
venv/
env/

# Ignore Docker metadata
*.log
docker-compose.override.yml

# Ignore system files
.DS_Store
Thumbs.db

# Ignore IDE/editor settings
.vscode/
.idea/

# Ignore output logs or temporary files
output/*.html
output/*.txt

# BUT keep the output directory itself
!output/.gitkeep
